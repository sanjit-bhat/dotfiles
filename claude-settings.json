{
  "permissions": {
    "allow": [
      "WebFetch",
      "WebSearch"
    ],
    "skipDangerousModePermissionPrompt": true
  },
  "model": "opus[1m]",
  "worktree": {
    "baseRef": "fresh"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true
  },
  "syntaxHighlightingDisabled": false,
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "light-daltonized",
  "editorMode": "vim"
}
